{
  "name": "avatar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:website": "VITE_DIRECT_API_URL=/api/v1/avatar/direct npm run build -- --base=/avatar/",
    "postbuild": "node tools/build-social-pages.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "render": "node tools/render.mjs",
    "test:director": "python3 -m unittest discover -s tests -p 'test_*director.py'",
    "test:character": "python3 -m unittest discover -s tests -p 'test_character_asset.py'",
    "test:worker": "node --test tests/paw-worker.test.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "lucide-react": "0.544.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "three-stdlib": "2.36.1"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.6.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  },
  "description": "Direct an avatar with words and edit every joint in its motion tree.",
  "repository": {
    "type": "git",
    "url": "https://github.com/programasweights/avatar.git"
  },
  "license": "MIT"
}
