{
  "description": "Held-out paraphrases and mixed-command acceptance cases. Original held-out phrases are excluded from training specifications. These check language command meaning; browser tests check actual resulting poses.",
  "cases": [
    {
      "id": "heldout_coin_alias",
      "instruction": "Show me a coin roll.",
      "expected": [
        "skill coin_roll left forward"
      ],
      "category": "heldout",
      "expected_route": "dexterity"
    },
    {
      "id": "heldout_coin_polite_right",
      "instruction": "I would like you to walk a coin over your right knuckles.",
      "expected": [
        "skill coin_roll right forward"
      ],
      "category": "heldout",
      "expected_route": "dexterity"
    },
    {
      "id": "heldout_coin_order",
      "instruction": "Walk the coin from the little finger toward the index finger of the right hand.",
      "expected": [
        "skill coin_roll right reverse"
      ],
      "category": "heldout",
      "expected_route": "dexterity"
    },
    {
      "id": "heldout_thumb_polite",
      "instruction": "Would you mind moving only your right thumb?",
      "expected": [],
      "category": "heldout",
      "expected_patterns": [
        "(?:joint|wiggle) right_thumb_1 z -[1-9]\\d*(?:\\.\\d+)?"
      ],
      "expected_route": "joint"
    },
    {
      "id": "heldout_thumb_curl",
      "instruction": "Can you curl just the left thumb by 25 degrees?",
      "expected": [
        "joint left_thumb_1 z 25"
      ],
      "category": "heldout",
      "expected_route": "joint"
    },
    {
      "id": "heldout_keep_dance_finger",
      "instruction": "Leave the salsa as it is and bend your right elbow 25 degrees.",
